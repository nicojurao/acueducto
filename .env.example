# Plantilla de configuración para desplegar Fluvi a un cliente nuevo (otro acueducto).
# Copia este archivo a ".env" en la raíz del proyecto y completa los valores reales — "npm run"
# en local con docker-compose.yml, o docker-compose.prod.yml para producción, los leen de acá.
# Ver ONBOARDING.md para la guía completa paso a paso de cómo levantar un cliente nuevo.
#
# Solo van acá los SECRETOS DE INFRAESTRUCTURA: sin ellos la app ni siquiera arranca, así que no
# pueden vivir en la base de datos. Todo lo "de negocio" (nombre, logo, color, dominios, SMTP,
# catastral) se configura DESPUÉS, desde el wizard de primer uso dentro de la propia app —
# no hace falta editar nada más de este archivo ni reconstruir la imagen por cliente.

# ── Base de datos ──────────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Autenticación ──────────────────────────────────────────────────────────────────────────────
# Cadena larga y aleatoria, distinta para cada cliente — firma los JWT de sesión.
# Generarla con: openssl rand -base64 48
JWT_SECRET=

# ── Almacenamiento de archivos (MinIO) ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Túnel de Cloudflare ────────────────────────────────────────────────────────────────────────
# Token del túnel de ESTE cliente (Cloudflare Zero Trust → Networks → Tunnels) — expone los
# dominios (operativo/pqrs/calidad) sin abrir puertos. Cada cliente tiene el suyo propio.
CLOUDFLARE_TUNNEL_TOKEN=

# ── CORS: red de seguridad para desarrollo ─────────────────────────────────────────────────────
# Los 3 dominios reales del cliente NO van acá — el wizard los guarda en la base de datos y el
# backend los consulta en caliente (ver backend/src/lib/empresaCache.ts). Esta variable es solo
# un fallback fijo para casos sin dominio configurado aún (ej. localhost en desarrollo). Se puede
# dejar tal cual o vacía en producción.
CORS_ORIGINS=http://localhost:5173
