generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Suscriptor {
  id                  Int       @id @default(autoincrement())
  nombre              String
  codigo              String    @unique
  ruta                String?

  primerNombre        String?
  segundoNombre       String?
  primerApellido      String?
  segundoApellido     String?
  identificacion      String?
  barrioId            Int?
  barrioCat           Barrio?   @relation(fields: [barrioId], references: [id])
  direccion           String?
  direccionComercial  String?
  estratoId           Int?
  estratoCat          Estrato?  @relation(fields: [estratoId], references: [id])
  latitud             Float?
  longitud            Float?

  // "sin_medidor" | "instalado_prueba" | "facturando" | "inactivo"
  estadoFacturacion   String    @default("sin_medidor")

  // "activo" | "inactivo". Un predio inactivo (lote baldío, demolido, etc.) no puede tener
  // medidor asignado — se valida en las rutas de suscriptores/actas, no solo en la UI.
  estadoPredio        String    @default("activo")
  // Servicios contratados: si uno esta apagado, ese concepto NO se factura a este suscriptor.
  tieneAcueducto      Boolean   @default(true)
  tieneAlcantarillado Boolean   @default(true)
  // Consumo (m3) que se le factura mientras no tenga medidor (estado sin_medidor o
  // instalado_prueba) o si el periodo no tuvo lectura real. Es POR SUSCRIPTOR (no de la
  // tarifa): cada predio puede tener un consumo predeterminado distinto segun lo que decida
  // la empresa (ej. tamano del predio, historico previo, etc).
  consumoPredeterminadoM3 Decimal @db.Decimal(12, 2) @default(0)
  // Consumo predeterminado PROPIO para alcantarillado (independiente del de acueducto): el
  // alcantarillado a veces lo presta otra empresa, con su propio promedio de referencia
  // distinto al nuestro. Solo se usa cuando no hay lectura real (ahi ambos servicios comparten
  // el mismo consumo medido, porque es la misma agua).
  consumoPredeterminadoAlcantarilladoM3 Decimal @db.Decimal(12, 2) @default(0)

  // Número Predial Nacional (NPN) del IGAC: identificador catastral único, de 30 dígitos desde
  // 2014 (reemplazó al código catastral anterior, de 20 dígitos y de longitud variable por
  // municipio antes de eso). Se guardan ambos porque un mismo predio puede tener el código
  // clásico de 20 dígitos en documentos viejos y el NPN de 30 en los nuevos — ninguno reemplaza
  // al otro en los registros históricos. Opcionales y sin validar longitud fija en BD porque el
  // histórico importado no los trae completos para todos los predios — se valida en la ruta al
  // capturarlos manualmente.
  numeroPredialNacional20     String?
  numeroPredialNacional        String?
  // Código SUI de condición de propiedad del predio: "00" propietario, "01" poseedor,
  // "02" tenedor a cualquier titulo, "03" arrendatario. "000" (el que trae el histórico
  // importado) significa "no reportado".
  condicionPropiedadPredioIgac String? @default("000")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  medidores           Medidor[]
  cotitularDe         Cotitular?
  facturas            Factura[]
  omisionesFacturacion FacturacionOmitida[]
  terceroId           Int?
  tercero             Tercero?  @relation(fields: [terceroId], references: [id])
  actas               ActaInstalacion[]
  pqrs                Pqr[]

  @@index([barrioId])
  @@index([estratoId])
}

// Catálogo de barrios, editable desde la pestaña de Barrios/Estratos. Permite pre-registrar
// barrios nuevos antes de que exista un suscriptor con ese valor.
model Barrio {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique
  // "urbano" | "rural" — la Resolución CRA 825 de 2017 trata distinto el área rural (aplica
  // independientemente del número de suscriptores, y algunos rangos/beneficios difieren).
  zona         String       @default("urbano")
  createdAt    DateTime     @default(now())
  suscriptores Suscriptor[]
}

// Catálogo de estratos (1, 2, 3, 4, Comercial, Oficial), editable desde la pestaña de
// Barrios/Estratos — antes era una lista fija en el código que aceptaba cualquier valor sin
// validar, lo que dejaba colar estratos inexistentes (ej. "7") al importar desde Excel.
model Estrato {
  id           Int          @id @default(autoincrement())
  codigo       String       @unique
  etiqueta     String
  // Código catastral IGAC del estrato, distinto del código SSPD que ya vive en `codigo` — los
  // reportes SUI (Formato 279) piden ambas codificaciones por separado, y no siempre coinciden.
  codigoIgac   String?
  createdAt    DateTime     @default(now())
  suscriptores Suscriptor[]
  tarifas      TarifaEstrato[]
}

model MarcaMedidor {
  id       Int             @id @default(autoincrement())
  nombre   String          @unique
  modelos  ModeloMedidor[]
  medidores Medidor[]
}

model ModeloMedidor {
  id              Int          @id @default(autoincrement())
  nombre          String
  tipo            String        // "volumetrico" | "velocidad"
  clasePrecision  String?       // ej. "A", "B", "C", "R100", "R160"
  varianteId      Int?
  varianteCat     VarianteMedidor? @relation(fields: [varianteId], references: [id])
  marcaId         Int
  marca           MarcaMedidor  @relation(fields: [marcaId], references: [id])
  medidores       Medidor[]
  diametros       DiametroMedidor[]

  @@unique([marcaId, nombre])
}

model DiametroMedidor {
  id        Int       @id @default(autoincrement())
  valor     String    @unique // ej. 1/2", 3/4", 1"
  medidores Medidor[]
  modelos   ModeloMedidor[]
}

// Sub-variante del tipo de medición: para "velocidad" son CU (Chorro Único) / CM (Chorro
// Múltiple); para "volumetrico" son PR (Pistón Rotativo) / DN (Disco Nutante). A lo sumo una
// por modelo (a diferencia de los diámetros, que un modelo puede tener varios).
model VarianteMedidor {
  id       Int             @id @default(autoincrement())
  codigo   String          @unique // "CU", "CM", "PR", "DN"
  etiqueta String          // "Chorro Único", "Chorro Múltiple", "Pistón Rotativo", "Disco Nutante"
  tipo     String          // "volumetrico" | "velocidad" — a cuál tipo aplica
  modelos  ModeloMedidor[]
}

// Una caja de fábrica trae varios medidores con seriales consecutivos (ej. 23001 a 23020); el
// lote agrupa esa caja para trazabilidad/garantía. La acta de calibración es individual por
// medidor (ver Medidor.actaCalibracionUrl), no vive acá.
model Lote {
  id            Int       @id @default(autoincrement())
  serialInicial String
  serialFinal   String
  fechaCompra   DateTime?
  observaciones String?
  createdAt     DateTime  @default(now())
  medidores     Medidor[]

  @@unique([serialInicial, serialFinal])
}

model Medidor {
  id                  Int       @id @default(autoincrement())
  suscriptorId        Int?
  suscriptor          Suscriptor? @relation(fields: [suscriptorId], references: [id])
  serial              String?   @unique
  estado              String    @default("instalado") // "en_bodega" | "instalado"
  condicion           String    @default("bueno") // "bueno" | "danado" — estado físico, independiente de si está instalado o en bodega

  marcaId             Int?
  marcaCat            MarcaMedidor? @relation(fields: [marcaId], references: [id])
  modeloId            Int?
  modeloCat           ModeloMedidor? @relation(fields: [modeloId], references: [id])
  diametroId          Int?
  diametroCat         DiametroMedidor? @relation(fields: [diametroId], references: [id])

  fechaInstalacion    DateTime?
  tipo                String?
  fechaFabricacion    DateTime?
  fechaCertificacion  DateTime?
  clase               String?
  certificado         String?
  loteId              Int?
  lote                Lote?     @relation(fields: [loteId], references: [id])
  actaCalibracionUrl  String?   // acta de calibración escaneada (PDF o imagen), individual por medidor
  lecturaInicial      Decimal?  @db.Decimal(12, 2)
  activo              Boolean   @default(true)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  lecturas            Lectura[]
  cotitulares         Cotitular[]
  actas               ActaInstalacion[]
  novedadesLectura    NovedadLectura[]

  @@index([suscriptorId])
  @@index([estado])
}

model ActaInstalacion {
  id                Int       @id @default(autoincrement())
  medidorId         Int
  medidor           Medidor   @relation(fields: [medidorId], references: [id])
  suscriptorId      Int
  suscriptor        Suscriptor @relation(fields: [suscriptorId], references: [id])
  serial            String
  fechaInstalacion  DateTime
  fechaRetiro       DateTime? // si se le quitó el medidor al suscriptor sin reemplazo: la acta
                              // se conserva como historial en vez de borrarse, con esta fecha.
  instaladoPor      String    // snapshot de texto: quién instaló, tal como se llamaba en ese momento.
                              // No se actualiza si el usuario cambia de nombre después (documento histórico).
  usuarioId         Int?      // FK opcional al usuario real, cuando se puede enlazar. Puede quedar
                              // null (actas antiguas sin vincular, o instalador ya no existe en el sistema).
  usuario           Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  observaciones     String?
  fotos             String[]
  actaFirmadaUrl    String?   // el PDF/imagen que genera la app es solo para imprimir y firmar a
                               // mano; esto guarda el escaneo YA FIRMADO, documento legal distinto
                               // de las fotos de evidencia de la instalación.
  createdAt         DateTime  @default(now())

  @@index([suscriptorId])
  @@index([medidorId])
}

// Registro de auditoría: un renglón por cada campo que cambió en un Medidor o Suscriptor
// (serial, nombre, estrato, etc.), con el valor anterior y el nuevo ya en texto legible
// (nombres de catálogo resueltos, no IDs) para no tener que traducir nada en el frontend.
model HistorialCambio {
  id            Int       @id @default(autoincrement())
  entidad       String    // "medidor" | "suscriptor"
  entidadId     Int
  campo         String
  valorAnterior String?
  valorNuevo    String?
  usuarioId     Int?
  usuario       Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fecha         DateTime  @default(now())

  @@index([entidad, entidadId])
  @@index([fecha])
  @@index([usuarioId, fecha])
}

// Suscriptor adicional que comparte un mismo medidor (acometida multiusuario).
// El consumo del medidor se reparte en partes iguales entre el titular (Medidor.suscriptorId) y sus cotitulares.
model Cotitular {
  id           Int        @id @default(autoincrement())
  medidorId    Int
  medidor      Medidor    @relation(fields: [medidorId], references: [id])
  suscriptorId Int        @unique
  suscriptor   Suscriptor @relation(fields: [suscriptorId], references: [id])
  createdAt    DateTime   @default(now())
}

model Lectura {
  id              Int       @id @default(autoincrement())
  medidorId       Int
  medidor         Medidor   @relation(fields: [medidorId], references: [id])

  periodo         DateTime  // primer día del mes, ej 2026-06-01
  valorLectura    Decimal   @db.Decimal(12, 2)
  consumo         Decimal   @db.Decimal(12, 2)
  observaciones   String?

  // Evidencia de la toma: foto del medidor y coordenadas donde se capturó (no se usan
  // para actualizar el pin del suscriptor en el Mapa, son solo auditoría de la lectura).
  fotoUrl         String?
  latitud         Float?
  longitud        Float?
  capturadoPorId  Int?
  capturadoPor    Usuario?  @relation(fields: [capturadoPorId], references: [id], onDelete: SetNull)

  fechaRegistro   DateTime  @default(now())

  @@unique([medidorId, periodo])
  @@index([periodo])
}

model Usuario {
  id              Int       @id @default(autoincrement())
  nombre          String
  nombreUsuario   String    @unique
  passwordHash    String
  rolId           Int
  rol             Rol       @relation(fields: [rolId], references: [id])
  activo          Boolean   @default(true)

  cedula          String?   @unique
  celular         String?
  fechaNacimiento DateTime?
  foto            String?

  createdAt       DateTime  @default(now())

  lecturas        Lectura[]
  aforos          Aforo[]
  prestamos       PrestamoInventario[]
  movimientosInventario MovimientoInventario[]
  itemsIngresados ItemInventario[]
  actasInstaladas ActaInstalacion[]
  cambiosRealizados HistorialCambio[]
  sesiones        InicioSesion[]
  pagosRegistrados Pago[]
  periodosCerrados PeriodoFacturacion[]
}

// Un renglón por cada login exitoso, para auditoría. Cada login trae un "jti" propio (id
// aleatorio único del token, ver firmarToken en middleware/auth.js) que permite revocarlo
// individualmente: requireAuth valida el JWT normalmente (firma + expiración) y ADEMÁS busca
// este renglón por jti — si existe y revocada=true, rechaza la sesión aunque el token siga
// siendo válido criptográficamente. Es la única forma de "cerrar sesión" de otro dispositivo
// que existe en este sistema, ya que el JWT en sí no tiene logout server-side.
// Para agrupar "qué cambios se hicieron en esta sesión" se usa una ventana de tiempo: desde
// este login hasta el siguiente login del mismo usuario (o hasta ahora, si es el más reciente)
// — ver GET /api/auditoria/:id/cambios.
model InicioSesion {
  id          Int      @id @default(autoincrement())
  usuarioId   Int
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
  jti         String?  @unique
  revocada    Boolean  @default(false)
  ip          String?
  userAgent   String?
  dispositivo String?  // resumen legible del userAgent (ej. "Android · Chrome")
  ciudad      String?  // geolocalización aproximada por IP (best-effort, puede quedar null)
  region      String?
  pais        String?
  fecha       DateTime @default(now())

  @@index([usuarioId, fecha])
}

// Un renglón por cada intento de login que falló (usuario/cédula inexistente, contraseña
// incorrecta, cuenta inactiva). Sin FK a Usuario a propósito: el identificador puede no
// corresponder a ningún usuario real (typo, o alguien probando cédulas al azar).
model IntentoLoginFallido {
  id            Int      @id @default(autoincrement())
  identificador String
  ip            String?
  userAgent     String?
  dispositivo   String?
  motivo        String   // "usuario_no_existe" | "contrasena_incorrecta" | "cuenta_inactiva"
  fecha         DateTime @default(now())

  @@index([fecha])
  @@index([identificador, fecha])
}

// Marca eventos de seguridad de todo el sistema, hoy solo "rotacion_secreto": cuando se rota
// JWT_SECRET a mano (fuera de la app, editando .env), todo token emitido ANTES de ese momento
// queda inválido de una — pero la app no tiene forma automática de enterarse de eso. Este
// registro se inserta a mano en ese momento para que "sesión activa" en Auditoría sepa
// descontar las sesiones que en realidad ya murieron por la rotación, no solo por los días
// transcurridos.
model EventoSeguridad {
  id    Int      @id @default(autoincrement())
  tipo  String   // "rotacion_secreto"
  fecha DateTime @default(now())
}

// Inventario general del acueducto: herramientas, equipos e insumos de la operación (distinto
// del inventario de Medidores, que ya tiene su propio módulo). Un mismo modelo cubre tanto
// insumos apilables (ej. tubos, accesorios — cantidad alta, nunca se prestan) como equipos
// individuales prestables (ej. una motosierra — cantidad 1, se asigna a un responsable vía
// PrestamoInventario). La disponibilidad se calcula: cantidad - suma de préstamos activos.
model ItemInventario {
  id            Int      @id @default(autoincrement())
  nombre        String
  categoriaId   Int?
  categoriaCat  CategoriaInventario? @relation(fields: [categoriaId], references: [id])
  codigo        String?  @unique // placa/código de inventario, opcional
  descripcion   String?
  cantidad      Int      @default(1)
  stockMinimo   Int? // opcional: si "disponible" cae a este número o menos, se marca como stock bajo
  unidadMedida  String   @default("unidad") // "unidad" | "metro" | "kilogramo" | "litro" | "galon" | "rollo" | "caja" | "par"
  estado        String   @default("bueno") // "bueno" | "regular" | "dañado" | "de_baja"
  ubicacionId   Int?
  ubicacionCat  UbicacionInventario? @relation(fields: [ubicacionId], references: [id])
  proveedorId   Int?
  proveedor     ProveedorInventario? @relation(fields: [proveedorId], references: [id])
  fechaCompra   DateTime?
  fechaIngreso  DateTime?
  valor         Decimal? @db.Decimal(12, 2) // valor unitario
  ingresadoPorId Int?
  ingresadoPor  Usuario? @relation(fields: [ingresadoPorId], references: [id], onDelete: SetNull)
  fotoUrl       String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prestamos     PrestamoInventario[]
  movimientos   MovimientoInventario[]
}

// Catálogos administrables del módulo de Inventario general. Se administran aparte (crear la
// categoría/ubicación/proveedor antes) en vez de escribirse libremente al crear un ítem.
model CategoriaInventario {
  id        Int              @id @default(autoincrement())
  nombre    String           @unique
  createdAt DateTime         @default(now())
  items     ItemInventario[]
}

model UbicacionInventario {
  id        Int              @id @default(autoincrement())
  nombre    String           @unique
  createdAt DateTime         @default(now())
  items     ItemInventario[]
}

model ProveedorInventario {
  id        Int              @id @default(autoincrement())
  nombre    String           @unique
  contacto  String?
  telefono  String?
  createdAt DateTime         @default(now())
  items     ItemInventario[]
}

model PrestamoInventario {
  id              Int            @id @default(autoincrement())
  itemId          Int
  item            ItemInventario @relation(fields: [itemId], references: [id])
  usuarioId       Int
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  cantidad        Int            @default(1)
  fechaEntrega    DateTime       @default(now())
  fechaEsperadaDevolucion DateTime? // opcional: para marcar como "vencido" un préstamo sin devolver
  fechaDevolucion DateTime? // null = todavía está prestado
  observaciones   String?
  createdAt       DateTime       @default(now())

  @@index([itemId, fechaDevolucion])
}

// Entradas (compra, reposición), salidas (consumo, ej. tubos usados en una instalación) y
// transferencias (cambio de ubicación, no toca "cantidad") de stock — distinto de
// PrestamoInventario, que es para equipos que se prestan y se devuelven.
// Una entrada suma "cantidad" al ItemInventario, una salida la resta, una transferencia no la
// toca (solo cambia ubicacionId del ítem, registrada acá para dejar rastro).
model MovimientoInventario {
  id            Int            @id @default(autoincrement())
  itemId        Int
  item          ItemInventario @relation(fields: [itemId], references: [id])
  tipo          String // "entrada" | "salida" | "transferencia"
  cantidad      Int
  motivo        String?
  observaciones String?
  usuarioId     Int?
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())

  @@index([itemId])
}

// Roles configurables. "admin" y "fontanero" vienen del sistema (esSistema=true) y no se
// pueden editar ni eliminar desde la UI de Roles, para evitar quedarse sin acceso administrativo.
model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  esSistema   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  permisos    RolPermiso[]
  usuarios    Usuario[]
}

// Catálogo fijo de permisos por módulo (ver PERMISOS en backend/src/lib/permisos.ts).
model Permiso {
  id          Int          @id @default(autoincrement())
  clave       String       @unique
  nombre      String
  descripcion String?

  roles       RolPermiso[]
}

model RolPermiso {
  rolId     Int
  permisoId Int
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

// Una fila por día: tamaño de la BD Postgres y de MinIO en ese momento, para graficar la
// tendencia de crecimiento en el Panel de administración. La escribe un cron interno del
// backend (ver src/lib/snapshotAlmacenamiento.ts), no el usuario.
model SnapshotAlmacenamiento {
  id             Int      @id @default(autoincrement())
  fecha          DateTime @unique // día (medianoche UTC), una sola foto por día
  tamanoBdBytes  BigInt
  tamanoMinioBytes BigInt
  createdAt      DateTime @default(now())
}

// Foto de los KPIs del dashboard que dependen del estado ACTUAL del suscriptor (cobertura con
// medidor, facturados por medición) — a diferencia del consumo/lecturas, que ya son históricamente
// exactos porque se filtran por el campo periodo de Lectura. Se toma el día 19 de cada mes (justo
// antes de que arranque la captura del periodo siguiente, día 20) para que el dashboard de un mes
// ya cerrado no cambie según el estado de HOY. Ver backend/src/lib/snapshotPeriodo.ts.
model SnapshotPeriodo {
  id                    Int      @id @default(autoincrement())
  periodo               String   @unique // "YYYY-MM"
  suscriptoresActivos   Int
  medidoresActivos      Int
  sinMedidor            Int
  instaladoPrueba       Int
  facturando            Int
  inactivo              Int
  createdAt             DateTime @default(now())
}

// Módulo de Aforos: mide caudal de una fuente/bocatoma (no de un medidor de suscriptor).
// Independiente del módulo de Medición (Suscriptor/Medidor/Lectura).
model PuntoAforo {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  latitud     Float?
  longitud    Float?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  aforos      Aforo[]
}

model Aforo {
  id           Int        @id @default(autoincrement())
  puntoAforoId Int
  puntoAforo   PuntoAforo @relation(fields: [puntoAforoId], references: [id])

  fecha        DateTime
  metodo       String     // "volumetrico" | "flotador"

  // método volumétrico: tiempo en llenar un recipiente de volumen conocido
  volumenLitros   Decimal? @db.Decimal(10, 2)

  // tiempoSegundos es el promedio final usado en el cálculo (volumétrico: valor único
  // ingresado; flotador: promedio de "tiempos", varias corridas del flotador en el mismo
  // tramo). "tiempos" guarda cada medición cruda para trazabilidad, solo se usa en flotador.
  tiempoSegundos  Decimal? @db.Decimal(10, 2)
  tiempos         Float[]  @default([])

  // método flotador: velocidad superficial (distancia/tiempoSegundos) x área de la sección
  // transversal del cauce. El área se mide en dos secciones del tramo (aguas arriba/"alta" y
  // aguas abajo/"baja", porque el cauce rara vez es uniforme) y se promedian. Cada sección se
  // mide como ancho (un solo valor) x profundidad promedio (5 medidas de profundidad tomadas
  // a lo ancho de esa sección, para compensar que el fondo no es plano).
  distanciaMetros    Decimal? @db.Decimal(10, 2)

  anchoAltaM         Decimal? @db.Decimal(10, 3)
  profundidadesAltaM Float[]  @default([])
  areaAltaM2         Decimal? @db.Decimal(10, 3) // anchoAltaM x promedio(profundidadesAltaM), calculado por el backend

  anchoBajaM         Decimal? @db.Decimal(10, 3)
  profundidadesBajaM Float[]  @default([])
  areaBajaM2         Decimal? @db.Decimal(10, 3) // anchoBajaM x promedio(profundidadesBajaM), calculado por el backend

  areaM2          Decimal? @db.Decimal(10, 3) // promedio de areaAltaM2/areaBajaM2, calculado por el backend

  caudalLps    Decimal    @db.Decimal(10, 3) // resultado final, siempre calculado por el backend

  observaciones String?
  fotoUrl        String?
  latitud        Float?
  longitud        Float?
  capturadoPorId Int?
  capturadoPor   Usuario?  @relation(fields: [capturadoPorId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())

  @@index([puntoAforoId])
  @@index([fecha])
}

// Registro de que a un medidor NO se le pudo tomar lectura en un periodo, con el motivo
// (ej. "predio cerrado", "medidor dañado", "no dejaron acceso"). Al capturar una lectura
// real para ese mismo medidor/periodo, la novedad se elimina.
model NovedadLectura {
  id        Int      @id @default(autoincrement())
  medidorId Int
  medidor   Medidor  @relation(fields: [medidorId], references: [id])
  periodo   DateTime // primer día del mes
  motivo    String
  fotos     String[] @default([])
  createdAt DateTime @default(now())

  @@unique([medidorId, periodo])
}

// ===================== FACTURACIÓN Y CARTERA (módulo comercial) =====================

// Tarifa vigente según la metodología de la Resolución CRA 825 de 2017 (prestadores de hasta
// 5.000 suscriptores): cargo fijo = CMA; cargo por consumo por m³ = CMO + CMI + CMT. Cada
// registro es una vigencia (vigenciaDesde = primer día del mes desde el que aplica); al generar
// la facturación de un periodo se usa la tarifa con la vigencia más reciente <= ese periodo.
// Los rangos de consumo (básico/complementario/suntuario) son configurables — para Mocoa
// (clima cálido, <1.000 msnm) la norma define básico 0-16 m³ y complementario hasta 32.
model Tarifa {
  id                      Int      @id @default(autoincrement())
  vigenciaDesde           DateTime // primer día del mes
  cma                     Decimal  @db.Decimal(12, 2) // cargo fijo mensual $/suscriptor
  cmo                     Decimal  @db.Decimal(12, 2) // $/m3
  cmi                     Decimal  @db.Decimal(12, 2) // $/m3
  cmt                     Decimal  @db.Decimal(12, 2) // $/m3
  rangoBasicoHastaM3      Int      @default(16)
  rangoComplementarioHastaM3 Int   @default(32)
  // Alcantarillado: misma estructura tarifaria que acueducto (cargo fijo = CMA propio; valor
  // m3 = CMO+CMI+CMT propios). Todos null = no se cobra alcantarillado en esta vigencia.
  alcCma                  Decimal? @db.Decimal(12, 2)
  alcCmo                  Decimal? @db.Decimal(12, 2)
  alcCmi                  Decimal? @db.Decimal(12, 2)
  alcCmt                  Decimal? @db.Decimal(12, 2)
  aseoCargoFijo           Decimal? @db.Decimal(12, 2)
  // % de interés de mora MENSUAL sobre el saldo vencido de una factura, parametrizable por
  // vigencia (0 = no se cobra mora todavía, valor por defecto). Se usa para reportar
  // "intereses por mora" en el SUI y, a futuro, para poder cobrarla — hoy solo se calcula
  // para mostrar/reportar, no se agrega automáticamente como concepto de la factura.
  tasaMoraMensual         Decimal  @db.Decimal(6, 3) @default(0)
  observaciones           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  estratos                TarifaEstrato[]
  facturas                Factura[]

  @@unique([vigenciaDesde])
}

// % de subsidio o contribución por estrato para una vigencia de tarifa. Negativo = subsidio
// (ej. -50 para estrato 1), positivo = contribución (ej. +50 comercial), 0 = tarifa plena.
// Según la norma, el subsidio aplica SOLO sobre el cargo fijo y el consumo básico; la
// contribución aplica sobre todo el servicio.
model TarifaEstrato {
  id         Int     @id @default(autoincrement())
  tarifaId   Int
  tarifa     Tarifa  @relation(fields: [tarifaId], references: [id], onDelete: Cascade)
  estratoId  Int
  estrato    Estrato @relation(fields: [estratoId], references: [id])
  porcentaje Decimal @db.Decimal(6, 2) @default(0)

  @@unique([tarifaId, estratoId])
}

model Factura {
  id               Int       @id @default(autoincrement())
  // Consecutivo de facturación. Lo asigna una SECUENCIA de Postgres (factura_numero_seq, ver
  // migración), no código de la app: nextval() es atómico, así que dos generaciones corriendo
  // al mismo tiempo nunca pueden calcular el mismo número (antes se calculaba en memoria con un
  // MAX(numero)+1 leído una sola vez al empezar — con dos corridas simultáneas eso podía chocar).
  numero           Int       @unique @default(dbgenerated("nextval('factura_numero_seq')::integer"))
  suscriptorId     Int
  suscriptor       Suscriptor @relation(fields: [suscriptorId], references: [id])
  periodo          DateTime  // primer día del mes facturado
  tarifaId         Int
  tarifa           Tarifa    @relation(fields: [tarifaId], references: [id])
  consumoM3        Decimal   @db.Decimal(12, 2)
  // Consumo de alcantarillado facturado — normalmente IGUAL a consumoM3 (misma agua medida),
  // salvo cuando no hay lectura real: ahi cada servicio puede usar su propio predeterminado
  // (acueducto y alcantarillado a veces son empresas distintas con promedios distintos).
  consumoAlcantarilladoM3 Decimal @db.Decimal(12, 2) @default(0)
  // Snapshots al momento de facturar (el suscriptor puede cambiar de estrato/estado después,
  // pero la factura emitida no debe cambiar retroactivamente):
  estratoCodigo    String?
  estadoFacturacion String
  sinMedidor       Boolean   @default(false) // true si el consumo fue el predeterminado, no lectura real
  subtotal         Decimal   @db.Decimal(12, 2) // antes de subsidio/contribución
  // % de subsidio (negativo) o contribución (positivo) aplicado, tal cual estaba en la tarifa
  // al facturar — se guarda el porcentaje ADEMÁS del resultado en pesos, para auditoría.
  porcentajeAplicado Decimal @db.Decimal(6, 2) @default(0)
  ajusteEstrato    Decimal   @db.Decimal(12, 2) @default(0) // subsidio (negativo) o contribución (positivo)
  total            Decimal   @db.Decimal(12, 2)
  estado           String    @default("pendiente") // "pendiente" | "pagada" | "anulada"
  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime?
  observaciones    String?
  conceptos        FacturaConcepto[]
  pagos            Pago[]

  @@unique([suscriptorId, periodo])
  @@index([periodo])
  @@index([estado])
}

// Renglones de la factura. Los generados por el motor llevan tipo estándar; los manuales
// (reconexión, matrícula, mora, acuerdo de pago, descuento) llevan tipo "manual".
model FacturaConcepto {
  id            Int     @id @default(autoincrement())
  facturaId     Int
  factura       Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  tipo          String  // cargo_fijo | consumo_basico | consumo_complementario | consumo_suntuario | alcantarillado_fijo | alcantarillado_consumo | aseo | ajuste_estrato | manual
  descripcion   String
  cantidad      Decimal? @db.Decimal(12, 2) // m3 para conceptos de consumo
  valorUnitario Decimal? @db.Decimal(12, 2)
  valor         Decimal  @db.Decimal(12, 2) // puede ser negativo (subsidio, descuento)
}

model Pago {
  id             Int      @id @default(autoincrement())
  facturaId      Int
  factura        Factura  @relation(fields: [facturaId], references: [id])
  valor          Decimal  @db.Decimal(12, 2)
  medio          String   @default("efectivo") // "efectivo" | "consignacion" | "otro"
  fecha          DateTime @default(now())
  observaciones  String?
  registradoPorId Int?
  registradoPor  Usuario? @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([facturaId])
  @@index([fecha])
}

// Editor visual de "sobreimpresión" de facturas: las facturas físicas vienen pre-impresas de la
// imprenta con su propio diseño/membrete, y acá solo se define EN QUÉ COORDENADAS va cada dato
// variable (nombre, consumo, total, etc.) sobre esa hoja — el PDF generado con una plantilla no
// dibuja fondo ni membrete propio, solo el texto en las posiciones guardadas (ver
// pdfFacturaPlantilla en routes/comercial/facturacion.ts). Puede haber varias plantillas
// guardadas (ej. si la imprenta cambia el formato) y se elige cuál usar al generar el PDF.
model PlantillaFactura {
  id            Int      @id @default(autoincrement())
  nombre        String
  // Guía visual SOLO para ubicar los marcadores en el editor (ej. un escaneo de la hoja
  // pre-impresa) — nunca se incluye en el PDF generado, es puramente de referencia al diseñar.
  imagenGuiaUrl String?
  // Tamaño de página en puntos PDF (72 pt = 1 pulgada). Carta = 612x792.
  anchoPt       Float    @default(612)
  altoPt        Float    @default(792)
  marcadores    MarcadorPlantilla[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MarcadorPlantilla {
  id          Int              @id @default(autoincrement())
  plantillaId Int
  plantilla   PlantillaFactura @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  // Clave del dato a mostrar — ver CAMPOS_DISPONIBLES en routes/comercial/facturacion.ts (ej.
  // "nombre", "nuid", "cargoFijo", "totalPagar").
  campo       String
  x           Float
  y           Float
  fontSize    Float   @default(9)
  align       String  @default("left") // "left" | "center" | "right"
  bold        Boolean @default(false)
  // Ancho de la "caja" de texto en puntos, para que align="center"/"right" tengan un ancho de
  // referencia sobre el cual centrarse/alinearse — sin esto, el texto se alinea a la izquierda
  // de (x,y) tal cual sin importar el "align" elegido.
  anchoCaja   Float?

  @@index([plantillaId])
}

// Tercero: la PERSONA (natural o jurídica) titular de uno o más suscriptores. El suscriptor es
// en realidad el predio/servicio (número predial, barrio, estrato); los datos personales para
// la facturación (y a futuro la facturación electrónica DIAN) viven acá. Una misma persona con
// varios predios = un tercero con varios suscriptores. Los creados por la migración inicial a
// partir de suscriptores SIN identificación llevan numeroDocumento "PEND-<suscriptorId>" como
// marcador de "pendiente de completar".
model Tercero {
  id              Int      @id @default(autoincrement())
  tipoDocumento   String   @default("CC") // CC | NIT | CE | TI | PP
  numeroDocumento String?  @unique
  nombre          String
  email           String?
  telefono        String?
  direccion       String?
  observaciones   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  suscriptores    Suscriptor[]
  pqrs            Pqr[]
}

// PQR (Petición/Queja/Reclamo/Sugerencia) radicada por el público desde pqrs.acbum.com.co —
// formulario SIN autenticación (cualquiera puede radicar), a diferencia de todo lo demás en este
// schema. terceroId/suscriptorId quedan opcionales porque quien radica puede no coincidir con
// ningún Tercero existente (no se le bloquea por eso, solo no queda enlazado) y porque una PQR no
// tiene por qué referirse a un predio puntual. nombre/documento/email/telefono se guardan tal
// cual se radicaron (aunque coincidan con un Tercero) para que la PQR quede como constancia fija
// de lo que la persona escribió ese día, sin depender de que el Tercero no cambie después.
model Pqr {
  id             Int         @id @default(autoincrement())
  // Null brevemente entre el create() y el update() que le pone el valor real (necesita el id
  // real, autoincremental, para armarlo) — Postgres permite varios NULL bajo un @unique sin que
  // choquen entre sí, así que dos radicaciones al mismo tiempo no compiten por ese instante.
  numeroRadicado String?     @unique
  terceroId      Int?
  tercero        Tercero?    @relation(fields: [terceroId], references: [id])
  suscriptorId   Int?
  suscriptor     Suscriptor? @relation(fields: [suscriptorId], references: [id])
  nombre         String
  documento      String?
  email          String
  telefono       String
  descripcion    String
  fotos          String[]    @default([])
  // "radicada" | "en_proceso" | "resuelta" | "cerrada" — el seguimiento/gestión interna de esto
  // (cambiar estado, responder) queda para una siguiente vuelta, no en este primer alcance.
  estado         String      @default("radicada")
  respuesta      String?
  // Cuándo se guardó "respuesta" — NO se puede usar updatedAt para esto (cambia con cualquier
  // edición, incluido un simple cambio de estado sin responder), y el reporte SUI necesita la
  // fecha exacta de la respuesta como columna aparte (ver lib/suiCausales.ts).
  respondidaEn   DateTime?

  // Clasificación para el reporte mensual de PQR al SUI (Resolución SSPD 20151300054575 de 2015,
  // modificada por la 20188000076635 de 2018 — ver lib/suiCausales.ts para el catálogo completo).
  // El ciudadano puede sugerir causal/detalleCausal al radicar (opcional, ver publico/pqrs.ts);
  // el staff interno los confirma o corrige, y es quien asigna tipoTramite/tipoRespuesta/
  // tipoNotificacion, que requieren criterio técnico/legal que no se le pide al ciudadano.
  tipoTramite      Int?    // 1-6: Reclamación/Queja/Denuncia/Recurso reposición/+Apelación/Solicitud info
  causal           String? // "F" (Facturación) o "P" (Prestación)
  detalleCausal    Int?    // código de 3 dígitos del Anexo (ej. 101, 303...)
  tipoRespuesta    Int?    // 1-11: Accede/Accede parcial/No accede/Confirma/Modifica/Revoca/Rechaza/...
  tipoNotificacion Int?    // 1-5: personal/edicto/no aplica/aviso/conducta concluyente
  // Solo aplica cuando tipoTramite=5 (Recurso de Reposición y Subsidiario de Apelación) y la
  // empresa confirma su decisión inicial — fecha en que se traslada el expediente a la SSPD.
  fechaTrasladoSspd DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  mensajes       PqrMensaje[]

  @@index([terceroId])
  @@index([suscriptorId])
  @@index([estado])
}

// Hilo de conversación de una PQR: el funcionario puede pedir una aclaración (sin cerrar el
// caso) y el ciudadano puede responderle desde la página pública de Consultar, y así seguir
// varias rondas. "respuesta"/"respondidaEn"/"tipoRespuesta"/"tipoNotificacion" en Pqr siguen
// siendo la respuesta OFICIAL para el reporte SUI — se llenan solo cuando el funcionario marca un
// mensaje suyo como "esRespuestaFinal" (puede ser el primero, o uno varios días después tras ida
// y vuelta, incluido documentar que el ciudadano respondió por otro medio, ej. una llamada).
model PqrMensaje {
  id               Int      @id @default(autoincrement())
  pqrId            Int
  pqr              Pqr      @relation(fields: [pqrId], references: [id], onDelete: Cascade)
  autor            String   // "staff" | "ciudadano"
  // Nombre de quien escribió, capturado tal cual en ese momento (no FK a Usuario) — mismo patrón
  // de denormalización que el resto de la app para registros de auditoría/histórico.
  autorNombre      String?
  texto            String
  archivos         String[] @default([])
  esRespuestaFinal Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([pqrId])
}

// Catálogo de causales del reporte SUI (Anexo A), editable desde el panel de Parametrización en
// vez de vivir fijo en código — si el SUI publica un anexo nuevo, o el staff detecta que falta
// alguna, se agrega sin necesitar un despliegue. Pqr.detalleCausal guarda el código tal cual (no
// es FK) a propósito: así un código nunca queda huérfano en el histórico si algún día se
// desactiva o se corrige el texto.
model PqrCausal {
  id        Int      @id @default(autoincrement())
  codigo    Int      @unique
  grupo     String // "F" (Facturación) o "P" (Prestación)
  detalle   String
  // Deja de ofrecerse en los selectores (radicar público, clasificar interno) pero no se borra:
  // preserva el histórico de cualquier PQR que ya lo tenga asignado.
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Fila única (id siempre 1) con parámetros editables del módulo de PQRS — hoy los tres encabezados
// que se anteponen a cada correo que le llega al ciudadano (radicación, respuesta/aclaración del
// funcionario, y cierre/respuesta final), pero deja espacio para más sin necesitar tabla nueva.
model PqrConfiguracion {
  id                   Int      @id @default(1)
  encabezadoRadicacion String   @default("")
  encabezadoRespuesta  String   @default("")
  encabezadoCierre     String   @default("")
  updatedAt            DateTime @updatedAt
}

// Fila única (id siempre 1) con la identidad de la entidad que opera este despliegue — antes vivía
// repartida entre .env (backend) y un archivo TS editado a mano (frontend); ahora se configura una
// sola vez desde el wizard de primer uso (o después, desde el panel de administración) y queda acá
// para que TODO el sistema (correos, PDFs, reporte SUI, CORS, dominios públicos) lea de un solo
// lugar. `configuradoEn` es la señal de "todavía falta el wizard" (null = falta).
model Empresa {
  id                Int       @id @default(1)
  // Datos de la empresa
  nit               String    @default("")
  nitDv             String    @default("")
  nombre            String    @default("")
  nombreCorto       String    @default("")
  direccion         String    @default("")
  sitioWeb          String    @default("")
  email             String    @default("")
  telefonos         String    @default("")
  // Marca: un solo color del que se deriva toda la escala visual (claro y oscuro), y el logo.
  colorMarca        String    @default("#00487f")
  logoRuta          String?
  // Catastral — código DANE (departamento-municipio-centro poblado) que exige el reporte SUI, y
  // el GLN de GS1 para el código de barras de recaudo en la factura (opcional, no todos lo tienen).
  daneDepartamento  String    @default("")
  daneMunicipio     String    @default("")
  daneCentroPoblado String    @default("")
  glnGs1            String    @default("")
  // Dominios reales del despliegue — de estos depende qué app se muestra por hostname, los links
  // de seguimiento en los correos de PQRS, y la whitelist de CORS.
  dominioOperativo  String    @default("")
  dominioPqrs       String    @default("")
  dominioCalidad    String    @default("")
  // Correo saliente (PQRS) — antes SMTP_* por variable de entorno.
  smtpHost          String    @default("")
  smtpPort          Int?
  smtpUser          String    @default("")
  smtpPass          String    @default("")
  smtpFrom          String    @default("")
  configuradoEn     DateTime?
  updatedAt         DateTime  @updatedAt
}

// Ciclo de facturación: cada periodo (mes) se genera entre los últimos días del mes y los
// primeros del siguiente, y una vez revisado se CIERRA — un periodo cerrado congela sus
// facturas (no anular, no conceptos nuevos) y sus lecturas (no editar/crear/borrar). Los pagos
// SÍ se siguen recibiendo siempre. Un permiso avanzado puede reabrirlo en caso excepcional,
// quedando registro de quién.
model PeriodoFacturacion {
  id              Int       @id @default(autoincrement())
  periodo         DateTime  @unique // primer día del mes
  estado          String    @default("abierto") // "abierto" | "cerrado"
  fechaGeneracion DateTime?
  fechaCierre     DateTime?
  // Fecha límite de pago del periodo, informativa (además de Factura.fechaVencimiento, que es
  // por factura individual): sirve de referencia para calcular cuándo se cumplen los mínimos de
  // mora del Art. 140 de la Ley 142 de 1994 (2 periodos si la facturación es bimestral, 3 si es
  // mensual) antes de poder suspender el servicio.
  fechaLimite     DateTime?
  // Fecha a partir de la cual un suscriptor en mora de este periodo puede pasar a estado
  // suspendido. Es SOLO el dato de la regla; Fluvi todavía no tiene un proceso que la use para
  // suspender automáticamente ni para dejar constancia del aviso previo que exige la Ley 142
  // (Art. 140: causal, recursos, plazo y autoridad) — eso queda pendiente como trabajo futuro.
  fechaSuspension DateTime?
  cerradoPorId    Int?
  cerradoPor      Usuario?  @relation(fields: [cerradoPorId], references: [id], onDelete: SetNull)
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Registro de suscriptores OMITIDOS en la generación de un periodo (inactivos, predio
// inactivo, sin servicios activos): el periodo queda documentado con el motivo, en vez de
// que el suscriptor simplemente "no aparezca" en la facturación.
model FacturacionOmitida {
  id           Int        @id @default(autoincrement())
  periodo      DateTime   // primer día del mes
  suscriptorId Int
  suscriptor   Suscriptor @relation(fields: [suscriptorId], references: [id])
  motivo       String     // "estado_inactivo" | "predio_inactivo" | "sin_servicios"
  createdAt    DateTime   @default(now())

  @@unique([suscriptorId, periodo])
  @@index([periodo])
}

// ===================== CALIDAD: control documental (SGC) =====================

// Documento controlado del Sistema de Gestión de Calidad (procedimiento, formato, instructivo,
// manual), identificado por su código (ej. P-OP-001, F-SGC-003). El documento en sí (el archivo)
// vive en VersionDocumentoSgc — este modelo es solo la ficha/identidad que agrupa sus versiones.
// Se consulta sin autenticación desde calidad.acbum.com.co (ver routes/publico/documentosSgc.ts),
// que solo expone los que estén en estado "vigente".
model DocumentoSgc {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique // "P-OP-001", "F-SGC-003", "I-...", "M-..."
  titulo    String
  tipo      String   // "procedimiento" | "formato" | "instructivo" | "manual"
  proceso   String   // "comercial" | "inventario" | "facturacion" | "calidad" | ...
  // "vigente" | "obsoleto" | "en_revision" — solo "vigente" se expone en el sitio público.
  estado    String   @default("vigente")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versiones VersionDocumentoSgc[]

  @@index([proceso])
  @@index([estado])
}

// Una fila por cada versión subida de un DocumentoSgc. Nunca se borra al subir una nueva versión
// (trazabilidad para auditorías ISO 9001): la anterior se marca vigente=false y queda de solo
// lectura. A lo sumo una versión por documento tiene vigente=true a la vez (se aplica en la ruta,
// no hay constraint de BD para eso — igual que el patrón de "una sola vigente" en Tarifa/Lectura).
model VersionDocumentoSgc {
  id                Int          @id @default(autoincrement())
  documentoId       Int
  documento         DocumentoSgc @relation(fields: [documentoId], references: [id])
  numeroVersion     Int
  archivoUrl        String
  vigente           Boolean      @default(true)
  fechaVigencia     DateTime
  descripcionCambio String?
  elaboroPor        String?
  revisoPor         String?
  aproboPor         String?
  createdAt         DateTime     @default(now())

  @@unique([documentoId, numeroVersion])
  @@index([documentoId, vigente])
}
